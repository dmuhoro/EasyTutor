# SUPABASE CONFIGURATION
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI CLOUD PROVIDER (ANTHROPIC)
# EXPO_PUBLIC_ANTHROPIC_API_KEY removed: Anthropic calls go through the server-side proxy.

# AI CLOUD PROVIDER (GROQ - Optional Fallback)
EXPO_PUBLIC_GROQ_API_KEY=your-groq-key

# LOCAL AI CONFIG (OLLAMA)
# On physical devices, use the Bridge discovery system.
# For Vercel, this should point to your public Ollama tunnel if applicable.
EXPO_PUBLIC_OLLAMA_HOST=127.0.0.1

# FEATURE FLAGS
EXPO_PUBLIC_ENABLE_TELEMETRY=true
EXPO_PUBLIC_DEBUG_MODE=false
