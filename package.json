{
  "name": "easytutor",
  "version": "1.16.4",
  "description": "Portal-mapped, offline-capable AI learning operating system for high school (KICD), university, and self-directed Polymath learners — local AI via Ollama, real document RAG with pgvector, and local-first progress sync.",
  "keywords": [
    "education",
    "ai-tutor",
    "adaptive-learning",
    "expo",
    "react-native",
    "supabase",
    "pgvector",
    "rag",
    "ollama",
    "offline-first",
    "llm",
    "personalized-learning"
  ],
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "npx eslint .",
    "lint:cycles": "depcruise --config .dependency-cruiser.js app lib services store src",
    "perf:budget": "node scripts/perf/check-entry-budget.js",
    "perf:login-route": "node scripts/perf/measure-login-route.js",
    "perf:lighthouse": "node scripts/perf/lighthouse_desktop.mjs",
    "qa:live-preflight": "node scripts/qa/live_proof_harness.mjs",
    "e2e:full": "playwright test -c playwright.demo.config.js",
    "e2e:smoke": "playwright test -c playwright.config.js tests/e2e/e2e.test.ts --project=mobile-390",
    "guard:public-env": "node scripts/security/check_public_env_allowlist.mjs",
    "guard:secret-exposure": "node scripts/security/check_secret_exposure.mjs",
    "check:imports": "node scripts/qa/check-declared-imports.mjs",
    "check:ai-boundary": "node scripts/qa/check-ai-boundary.mjs",
    "guard:secrets": "npm run guard:secret-exposure && npm run guard:public-env",
    "guard:dist": "node scripts/security/check_secret_exposure.mjs --include-dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.config.js",
    "test:flows": "vitest run -c vitest.config.js",
    "test:auth-flow": "vitest run -c vitest.integration.config.js tests/integration/authFlow.integration.test.ts",
    "build": "npx expo export --platform web && node scripts/pwa-assets.mjs",
    "verify:spa": "node scripts/serve-dist-spa.mjs",
    "serve:dist": "node scripts/serve-dist-spa.mjs --serve",
    "audit:full": "./scripts/full-audit.sh",
    "audit:governance": "node scripts/architecture/governance_audit.js",
    "readiness:check": "node scripts/readiness/score.mjs check",
    "readiness:score": "node scripts/readiness/score.mjs score",
    "readiness:next": "node scripts/readiness/score.mjs next",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.3.18",
    "@supabase/supabase-js": "^2.100.0",
    "autoprefixer": "^10.4.27",
    "clsx": "^2.1.1",
    "expo": "~57.0.31",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "nativewind": "^4.2.3",
    "postcss": "^8.5.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "zod": "4.6.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@react-native-community/cli": "latest",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "babel-preset-expo": "~57.0.0",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "lighthouse": "13.6.0",
    "playwright": "^1.65.1",
    "react-test-renderer": "^19.2.3",
    "serve": "^14.2.8",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  },
  "private": true,
  "overrides": {
    "shell-quote": "1.12.0"
  }
}
